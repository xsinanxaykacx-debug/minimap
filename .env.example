# Optional custom MapLibre style URL. Defaults to CARTO Dark Matter.
VITE_MAP_STYLE_URL=

# LAB Supabase URL; set only in Vercel Preview for the LAB project.
VITE_SUPABASE_URL_LAB=
# LAB Supabase anon key; set only in Vercel Preview. Never use service_role here.
VITE_SUPABASE_ANON_KEY_LAB=

# İBB camera-list proxy (defaults to the configured Cloudflare Worker)
VITE_IBB_CAMERA_PROXY_URL=https://aytar-ibb-cameras.xsinanxaykacx.workers.dev/

# Metered Open Relay — LAB test only.
# Comma-separated URLs; values are delivered to browser clients for WebRTC.
VITE_TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:80?transport=tcp,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
